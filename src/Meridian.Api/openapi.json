{
  "openapi": "3.0.1",
  "info": {
    "title": "Meridian Vote Tracker API",
    "version": "v1"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        },
        "tags": [
          "System"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "GetMetadata",
        "responses": {
          "200": {
            "description": "API metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metadata"
                }
              }
            }
          }
        },
        "tags": [
          "System"
        ]
      }
    },
    "/api/v1/imports": {
      "get": {
        "operationId": "ListImports",
        "responses": {
          "200": {
            "description": "Recent imports and durable progress",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImportRecord"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          }
        ],
        "tags": [
          "Imports"
        ]
      },
      "post": {
        "operationId": "CreateImport",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical file was already received",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportAccepted"
                }
              }
            }
          },
          "202": {
            "description": "Import queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Imports"
        ]
      }
    },
    "/api/v1/imports/{id}": {
      "get": {
        "operationId": "GetImport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Import status and report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportDetails"
                }
              }
            }
          },
          "404": {
            "description": "Import was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Imports"
        ]
      }
    },
    "/api/v1/imports/{id}/rows": {
      "get": {
        "operationId": "ListImportRows",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "after",
            "required": false,
            "in": "query",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "classification",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of staged row classifications and original values",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImportRow"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Imports"
        ]
      }
    },
    "/api/v1/conflicts": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "name": "voteId"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Pending",
                "Resolved",
                "Accepted",
                "Rejected",
                "All"
              ],
              "default": "Pending"
            }
          }
        ],
        "security": [
          {
            "DemoUser": []
          }
        ],
        "responses": {
          "200": {
            "description": "Open conflicts with current values and source proposals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Conflict"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Demo user header is missing or unknown",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "operationId": "ListPendingConflicts",
        "tags": [
          "Conflicts"
        ]
      }
    },
    "/api/v1/conflicts/{id}/decision": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "name": "id"
          }
        ],
        "security": [
          {
            "DemoUser": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "enum": [
                      "Accept",
                      "Reject"
                    ],
                    "type": "string"
                  },
                  "proposalIndex": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "note": {
                    "nullable": true,
                    "type": "string"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Decision applied and audited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictDecision"
                }
              }
            }
          },
          "400": {
            "description": "Invalid decision",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Demo user header is missing or unknown",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict has already changed or been resolved",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "operationId": "DecideConflict",
        "tags": [
          "Conflicts"
        ]
      }
    },
    "/api/v1/votes": {
      "get": {
        "operationId": "ListVotes",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Votes with current position and pending-conflict count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VoteSummary"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Votes"
        ]
      }
    },
    "/api/v1/snapshots": {
      "get": {
        "operationId": "ListSnapshots",
        "responses": {
          "200": {
            "description": "Snapshot history and durable progress",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Snapshot"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Snapshots"
        ]
      },
      "post": {
        "operationId": "CreateSnapshot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session": {
                    "type": "integer",
                    "nullable": true
                  },
                  "fromDate": {
                    "type": "string",
                    "format": "date",
                    "nullable": true
                  },
                  "toDate": {
                    "type": "string",
                    "format": "date",
                    "nullable": true
                  },
                  "voteIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Calculation queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Invalid selection or a selected vote has no position",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Snapshots"
        ]
      }
    },
    "/api/v1/snapshots/{id}": {
      "get": {
        "operationId": "GetSnapshot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot status, selection, progress, and publication history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "404": {
            "description": "Snapshot not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Snapshots"
        ]
      }
    },
    "/api/v1/snapshots/{id}/results": {
      "get": {
        "operationId": "ListSnapshotResults",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked country scores, participation, and coverage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SnapshotResult"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Snapshots"
        ]
      }
    },
    "/api/v1/snapshots/{id}/countries/{countryCode}/contributions": {
      "get": {
        "operationId": "ListSnapshotContributions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable per-vote contributions for one country",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VoteContribution"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Snapshots"
        ]
      }
    },
    "/api/v1/snapshots/{id}/publish": {
      "post": {
        "operationId": "PublishSnapshot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "year": {
                    "type": "integer"
                  },
                  "quarter": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "replaceActive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "year",
                  "quarter",
                  "replaceActive"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Snapshot published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationResult"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Snapshot missing or unfinished",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "A different active snapshot already exists",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Snapshots"
        ]
      }
    },
    "/api/v1/snapshots/{id}/withdraw": {
      "post": {
        "operationId": "WithdrawSnapshot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Publication withdrawn and audited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WithdrawResult"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Snapshot is not actively published",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Snapshots"
        ]
      }
    },
    "/api/v1/vote": {
      "get": {
        "operationId": "GetVote",
        "parameters": [
          {
            "name": "voteId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vote, current position, and audit timeline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoteDetails"
                }
              }
            }
          },
          "404": {
            "description": "Vote not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Votes"
        ]
      }
    },
    "/api/v1/vote/position": {
      "put": {
        "operationId": "SetVotePosition",
        "parameters": [
          {
            "name": "voteId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "stance",
                  "weight"
                ],
                "properties": {
                  "stance": {
                    "type": "string",
                    "enum": [
                      "Y",
                      "N"
                    ]
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "note": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Position version created and audited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid position",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Vote not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ],
        "tags": [
          "Votes"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DemoUser": {
        "type": "apiKey",
        "name": "X-Demo-User",
        "in": "header"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ]
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ]
      },
      "ImportRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "rowsProcessed": {
            "type": "integer"
          },
          "rowsTotal": {
            "type": "integer",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "nullable": true
          },
          "originalImportId": {
            "type": "string",
            "nullable": true
          },
          "uploadedBy": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "fileName",
          "status",
          "rowsProcessed",
          "rowsTotal",
          "createdAt",
          "completedAt",
          "originalImportId",
          "uploadedBy"
        ]
      },
      "ImportReport": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "votes": {
