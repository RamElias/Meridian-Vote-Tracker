{
  "openapi": "3.0.1",
  "info": {
    "title": "Meridian Vote Tracker API",
    "version": "v1"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "GetMetadata",
        "responses": {
          "200": {
            "description": "API metadata"
          }
        }
      }
    },
    "/api/v1/imports": {
      "get": {
        "operationId": "ListImports",
        "responses": {
          "200": {
            "description": "Recent imports and durable progress"
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ]
      },
      "post": {
        "operationId": "CreateImport",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Import queued"
          },
          "200": {
            "description": "Identical file was already received"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ]
      }
    },
    "/api/v1/imports/{id}": {
      "get": {
        "operationId": "GetImport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Import status and report"
          },
          "404": {
            "description": "Import was not found"
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ]
      }
    },
    "/api/v1/imports/{id}/rows": {
      "get": {
        "operationId": "ListImportRows",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "after",
            "required": false,
            "in": "query",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "classification",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of staged row classifications and original values"
          }
        },
        "security": [
          {
            "DemoUser": []
          }
        ]
      }
    },
    "/api/v1/conflicts": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "name": "voteId"
          }
        ],
        "security": [
          {
            "DemoUser": []
          }
        ],
        "responses": {
          "200": {
            "description": "Open conflicts with current values and source proposals"
          },
          "401": {
            "description": "Demo user header is missing or unknown"
          }
        },
        "operationId": "ListPendingConflicts"
      }
    },
    "/api/v1/conflicts/{id}/decision": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "name": "id"
          }
        ],
        "security": [
          {
            "DemoUser": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "enum": [
                      "Accept",
                      "Reject"
                    ],
                    "type": "string"
                  },
                  "proposalIndex": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "note": {
                    "nullable": true,
                    "type": "string"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Demo user header is missing or unknown"
          },
          "409": {
            "description": "Conflict has already changed or been resolved"
          },
          "200": {
            "description": "Decision applied and audited"
          },
          "400": {
            "description": "Invalid decision"
          }
        },
        "operationId": "DecideConflict"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DemoUser": {
        "type": "apiKey",
        "name": "X-Demo-User",
        "in": "header"
      }
    }
  }
}
