# Copy to .env and set a local-only password. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional Key Vault URI. For local Compose, the AZURE_* service-principal settings below
# are used as the bootstrap credential; Key Vault cannot provide the credential needed to access itself.
AZURE_KEY_VAULT_URI=
# Local development service principal (grant Key Vault Secrets User and Storage Blob Data Contributor).
# Keep these values only in this ignored .env file. Leave blank to use local-only services.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional external PostgreSQL connection string. Leave blank for Compose PostgreSQL.
# A Key Vault secret named ConnectionStrings--Meridian overrides this when Key Vault is enabled.
MERIDIAN_CONNECTION_STRING=

# Optional Azure Blob imports. Choose AzureBlob and set the Storage account endpoint;
# authentication uses DefaultAzureCredential, or set Storage--AzureBlob--ConnectionString in Key Vault.
STORAGE_PROVIDER=Local
AZURE_BLOB_SERVICE_URI=
AZURE_BLOB_CONTAINER=meridian-imports

# Optional Azure Monitor Application Insights connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=
